# CPython and NumPy retain allocator arenas, free lists, and process-global
# caches. These frames are not actionable C++ ownership leaks in Gambit.
# NumPy 2.3 on CPython 3.12 also retains two small array-descriptor allocations
# until process teardown. Keep this suppression frame-specific so allocations
# from Gambit's native extension remain visible to LeakSanitizer.
leak:PyArray_NewFromDescr_int
leak:_PyMem_RawMalloc
leak:PyMem_RawMalloc
leak:_PyObject_Malloc
leak:PyObject_Malloc
leak:PyMem_Malloc
leak:list_resize
leak:PyThread_allocate_lock
leak:PyDataMem_NEW
leak:default_calloc
leak:resize_compact
